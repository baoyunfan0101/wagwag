{
  "expo": {
    "name": "WagWag",
    "slug": "wagwag",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wagwag",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#335A4D",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your pet's profile and posts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F0",
          "image": "./assets/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WagWag needs your location to record a walk.",
          "locationAlwaysAndWhenInUsePermission": "Allow WagWag to record your walk while the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@rnmapbox/maps",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
