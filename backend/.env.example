# Local development only. Copy to .env; make backend loads it.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/wagwag
DATABASE_USER=wagwag
DATABASE_PASSWORD=wagwag
APP_DEV_PET_ID=1
APP_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

REDIS_URL=redis://localhost:6379
FOLLOW_CACHE_ENABLED=true
COMMUNITY_HOT_CACHE_ENABLED=true
REALTIME_REDIS_ENABLED=true

S3_BUCKET=wagwag-avatars
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_BASE_URL=http://localhost:8333/wagwag-avatars
S3_ACCESS_KEY=dev-access
S3_SECRET_KEY=dev-secret

# FFmpeg must include libx264 and AAC encoders. Optional CDN bucket prefix.
VIDEO_PROCESSING_ENABLED=true
FFMPEG_BIN=ffmpeg
MEDIA_PUBLIC_BASE_URL=

# Native push additionally needs EAS and APNs/FCM configuration.
EXPO_PUSH_ENABLED=false
EXPO_PUSH_BASE_URL=https://exp.host/--/api/v2/push
EXPO_PUSH_ACCESS_TOKEN=
